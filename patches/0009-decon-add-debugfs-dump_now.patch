+static ssize_t decon_dump_trigger_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct decon_device *decon = file->private_data;
+
+	if (*ppos)
+		return 0;
+	decon_dump(decon);
+	*ppos = 1;
+	return 0;
+}
+
+static const struct file_operations decon_dump_trigger_fops = {
+	.open = simple_open,
+	.read = decon_dump_trigger_read,
+};
