# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/exynos7570-j4lte_defconfig
maintainer="Hendra Manudinata <hendra@manoedinata.com>"
pkgname=linux-samsung-j4lte
pkgver=3.18.140
pkgrel=16
pkgdesc="Samsung Galaxy J4 kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="samsung-j4lte"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	gcc6
	openssl-dev
	perl
	dtbtool-exynos
"

# Source
_repository="android_kernel_samsung_universal7570"
_commit="57ffdcdde7e968af314e809cdab6b3ee24bc4d24"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/DaunScape/$_repository/archive/$_commit.tar.gz
	$_config
	0001-drivers-leds-ktd2692-Guard-function-calls-under-CONF.patch
	0002-zram-Set-zstd-as-the-default-compressor.patch
	0003-drivers-usb-u_ether-Force-setting-random-MAC-address.patch
	0004-staging-samsung-sec_batt-Force-disable-low-power-cha.patch
	0005-drivers-samsung-scsc-Fix-FW_LOCATION_AUTO-symbol.patch
	0006-drivers-samsung-scsc-Skip-mount-point-check.patch
	0007-fbdev-decon_7570-Initialize-framebuffer-more-late.patch
	0008-HACK-loop-Force-disable-Direct-I-O-operations.patch
	0009-decon-add-debugfs-dump_now.patch
	0010-dts-j4-dsim-pms-728.patch
	0011-dts-j330f-panel-power.patch
	0012-dts-j330f-porch.patch
	0013-dd-dpu-enable-debugfs.patch
	0014-dts-j330f-vclk-denom.patch
	0015-dts-j330f-isl98611-power-early.patch
	0016-dts-j330f-panel-rev.patch
	0017-dts-j330f-synaptics-touch.patch
	0018-touchscreen-skip-fw-update-on-probe.patch
	0019-touchscreen-synaptics-no-incell-build-fix.patch
	linux3.7to4.5-ARM64-remove-Sun-Solaris-style-flag-on-section.patch
	fix-check-lxdialog.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

# Compiler: GCC 6 (not tested with LLVM)
if [ "${CC:0:5}" != "gcc6-" ]; then
	CC="gcc6-$CC"
	HOSTCC="gcc6-gcc"
	CROSS_COMPILE="gcc6-$CROSS_COMPILE"
fi

prepare() {
	default_prepare
	. downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	# Build dt image with exynos dtbtool
	dtbTool-exynos --pagesize 2048 \
		--platform 0x50a6 \
		--subtype  0x217584da \
		-o "$_outdir/arch/$_carch/boot"/dt.img \
		$(find "$_outdir/arch/$_carch/boot/dts/" -name *.dtb)
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	install -Dm644 "$_outdir/arch/$_carch/boot"/dt.img \
		"$pkgdir"/boot/dt.img
}

